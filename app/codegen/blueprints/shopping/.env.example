# Aurora & Co. storefront — generated by NEXORA AI LABS
APP_NAME=Aurora & Co.
NODE_ENV=development
PORT=3000

# SQLite file, relative to the project root
DATABASE_PATH=data/store.db

# Session cookie lifetime (days) and cookie hardening
SESSION_DAYS=7
SESSION_COOKIE_NAME=nexora_shop_session
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Commerce rules (integer cents)
SHIPPING_FLAT_CENTS=650
FREE_SHIPPING_THRESHOLD_CENTS=7500
RATE_LIMIT_MAX=300

# Demo seed accounts (change before any real deployment)
SEED_ADMIN_EMAIL=admin@shop.test
SEED_ADMIN_PASSWORD=Admin1234!
SEED_DEMO_EMAIL=demo@shop.test
SEED_DEMO_PASSWORD=Demo1234!
