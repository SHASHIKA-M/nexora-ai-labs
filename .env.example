APP_NAME=Nexora AI Labs
DATABASE_URL=sqlite:///./nexora.db

# ---------------------------------------------------------------------------
# AI provider. NEXORA generates and reviews code with a LOCAL model only, so
# that no client requirement, source file or secret ever leaves this machine.
# Requirement: Ollama running locally with the configured model pulled.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Generated project workspaces
# ---------------------------------------------------------------------------
# Root folder for generated applications. Defaults to ./generated_projects
GENERATED_PROJECTS_DIR=

# ---------------------------------------------------------------------------
# Remote providers are intentionally NOT used for code generation.
# If you wire one up yourself, put the key in .env (never commit it) and treat
# every generated file as untrusted code — it still runs only in the sandbox.
# ---------------------------------------------------------------------------
MISTRAL_API_KEY=
GEMINI_API_KEY=
